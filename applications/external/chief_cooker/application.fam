# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="chief_cooker",  # Must be unique
    name="Chief Cooker",  # Displayed in menus
    apptype=DIYAppType.EXTERNAL,
    entry_point="chief_cooker_app",
    # 8K: C++ SubGhzModule (env+receiver+worker) + PagerReceiver protocols/decoders
    # overflowed 4K and hard-faulted inside scan startup.
    stack_size=8 * 1024,
    fap_category="Sub-GHz",
    # Optional values
    # fap_version="0.1",
    fap_icon="chief_cooker.png",  # 10x10 1-bit PNG
    # fap_description="A simple app",
    fap_author="Denr01",
    fap_weburl="https://github.com/denr01/FZ-ChiefCooker",
    fap_icon_assets="images",  # Image assets to compile for this application
    # Free icon/asset packs before ELF preload: the RX path needs a ~40KB
    # contiguous block and packs are restored on exit/fail (cf. mfkey).
    flags=["UnloadAssetPacks"],
)
