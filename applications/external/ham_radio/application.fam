App(
    appid="ham_radio",
    name="Ham Radio",
    apptype=DIYAppType.EXTERNAL,
    entry_point="ham_radio_app",
    requires=["gui"],
    stack_size=2 * 1024,
    fap_icon="ham_radio_10px.png",
    fap_category="Sub-GHz",
    fap_author="@AJ_60",
    fap_version="0.1",
    fap_description="Multi-frequency activity monitor and S-meter for the internal or external CC1101. Receive-only build; transmit stays locked behind a callsign and licence acknowledgement.",
    sources=[
        "ham_radio_app.c",
        "helpers/ham_settings.c",
        "helpers/ham_band.c",
        "helpers/ham_scan_worker.c",
        "views/ham_view_band.c",
        "views/ham_view_scan.c",
        "views/ham_view_tune.c",
        "scenes/ham_radio_scene.c",
        "scenes/ham_radio_scene_start.c",
        "scenes/ham_radio_scene_band.c",
        "scenes/ham_radio_scene_scan.c",
        "scenes/ham_radio_scene_tune.c",
        "scenes/ham_radio_scene_add_frequency.c",
        "scenes/ham_radio_scene_add_label.c",
        "scenes/ham_radio_scene_settings.c",
        "scenes/ham_radio_scene_settings_callsign.c",
        "scenes/ham_radio_scene_about.c",
    ],
)
