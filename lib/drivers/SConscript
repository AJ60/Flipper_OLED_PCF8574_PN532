Import("env")

env.Append(
    CPPPATH=[
        "#/lib/drivers",
    ],
    SDK_HEADERS=[
        File("rgb_backlight.h"),
        File("cc1101_regs.h"),
        File("pn532_reg.h"),
        File("pn532.h"),
    ],
    LINT_SOURCES=[
        Dir("."),
    ],
)


libenv = env.Clone(FW_LIB_NAME="hwdrivers")
libenv.ApplyLibFlags()

sources = [s for s in Glob("*.c", source=True) if not s.name.startswith("st25r3916")]

lib = libenv.StaticLibrary("${FW_LIB_NAME}", sources)
libenv.Install("${LIB_DIST_DIR}", lib)
Return("lib")
